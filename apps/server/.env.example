# ===== ZxBench Pro 服务端配置模板 =====
# 复制本文件为 .env 并按需修改

# SQLite 数据库路径（相对 prisma 目录；默认指向 data/zxbench.db）
DATABASE_URL="file:../../data/zxbench.db"

# 服务端口
PORT=3001

# 监听地址
ZXBENCH_HOST=127.0.0.1

# CORS 允许来源（默认关闭；需要跨域时填写，如 http://localhost:5173）
ZXBENCH_CORS_ORIGIN=

# 访问控制（生产环境必填；评测结果可匿名查看，管理 API 和写操作需管理员账号）
# 管理员首次登录浏览器时访问 https://eval.ajubyte.store/admin-login 完成登录挑战
ZXBENCH_PUBLIC_ORIGIN=https://eval.ajubyte.store
ZXBENCH_ADMIN_USER=YOUR_ADMIN_USERNAME
ZXBENCH_ADMIN_PASSWORD=YOUR_LONG_RANDOM_ADMIN_PASSWORD

# API Key 加密密钥（务必改成随机长字符串；一旦生成数据，修改此值将导致旧 API Key 无法解密）
ZXBENCH_ENCRYPTION_KEY=change-me-to-a-long-random-string
